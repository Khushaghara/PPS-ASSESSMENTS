
#include <stdio.h>

struct Student
{
    int roll_no;
    char name[50];
    float m1, m2, m3;
    float total, percentage;
};

int main()
{
    struct Student s[100];
    int n, i;

    printf("Enter number of students: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++)
    {
        printf("\nEnter roll no, name & marks of 3 subjects:\n");

        scanf("%d %49s %f %f %f",
              &s[i].roll_no,
              s[i].name,
              &s[i].m1,
              &s[i].m2,
              &s[i].m3);

        s[i].total = s[i].m1 + s[i].m2 + s[i].m3;

        s[i].percentage = (s[i].total / 300.0) * 100;
    }

    printf("\nRoll No\tName\tM1\tM2\tM3\tTotal\tPercentage\n");

    for (i = 0; i < n; i++)
    {
        printf("%d\t%s\t%.0f\t%.0f\t%.0f\t%.0f\t%.2f%%\n",
               s[i].roll_no,
               s[i].name,
               s[i].m1,
               s[i].m2,
               s[i].m3,
               s[i].total,
               s[i].percentage);
    }

    return 0;
}
