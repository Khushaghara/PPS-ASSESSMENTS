
#include <stdio.h>
#include <time.h>

int main()
{
    int year, i, day, daysInMonth;
    int startDay;

    char *months[] = {
        "January", "February", "March", "April",
        "May", "June", "July", "August",
        "September", "October", "November", "December"
    };

    int days[] = {
        31, 28, 31, 30, 31, 30,
        31, 31, 30, 31, 30, 31
    };

    struct tm date = {0};

    printf("Enter year: ");
    scanf("%d", &year);

    // Check leap year
    if ((year % 400 == 0) ||
        (year % 4 == 0 && year % 100 != 0))
    {
        days[1] = 29;
    }

    // Find first day of January
    date.tm_year = year - 1900;
    date.tm_mon = 0;
    date.tm_mday = 1;
    date.tm_hour = 12;

    mktime(&date);

    startDay = date.tm_wday;

    // Print calendar for all 12 months
    for (i = 0; i < 12; i++)
    {
        printf("\n\n      %s %d\n", months[i], year);
        printf("Sun Mon Tue Wed Thu Fri Sat\n");

        // Print spaces before first day
        for (day = 0; day < startDay; day++)
        {
            printf("    ");
        }

        daysInMonth = days[i];

        // Print all days of the month
        for (day = 1; day <= daysInMonth; day++)
        {
            printf("%3d ", day);

            if ((day + startDay) % 7 == 0)
            {
                printf("\n");
            }
        }

        // Calculate starting day of next month
        startDay = (startDay + daysInMonth) % 7;
    }

    return 0;
}
